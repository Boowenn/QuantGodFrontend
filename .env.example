# Vite dev proxy target for backend API requests.
QG_BACKEND_URL=http://127.0.0.1:8080

# Keep this empty for same-origin /api/* calls. Set it to an origin only when the
# frontend is intentionally served separately from the backend.
VITE_QG_API_BASE_URL=

# Long-running local build/review commands can take up to four minutes server-side.
VITE_QG_COMMAND_TIMEOUT_MS=300000
